		"devdoc": {
			"details": "Enterprise-grade decentralized SaaS and API licensing. Replaces Stripe and centralized databases for software access. Users buy time-bound cryptographic licenses. Backend servers verify access instantly.",
			"errors": {
				"OwnableInvalidOwner(address)": [
					{
						"details": "The owner is not a valid owner account. (eg. `address(0)`)"
					}
				],
				"OwnableUnauthorizedAccount(address)": [
					{
						"details": "The caller account is not authorized to perform an operation."
					}
				]
			},
			"kind": "dev",
			"methods": {
				"buyLicense(uint256,uint256)": {
					"details": "2. User purchases or renews their license.",
					"params": {
						"_multiplier": "How many time blocks to buy (e.g., 3 = 90 days).",
						"_tierId": "The ID of the software tier."
					}
				},
				"createTier(string,uint256,uint256)": {
					"details": "1. Admin creates an access tier (e.g., \"Pro API Access\", 0.05 ETH, 30 Days)."
				},
				"getExpiration(uint256,address)": {
					"details": "View function to get exact expiration time."
				},
				"isValid(uint256,address)": {
					"details": "4. The Developer's Backend calls this free View function to check access. e.g., if (contract.isValid(1, \"0xUser...\")) { serveData(); } else { throw 403; }"
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"toggleTier(uint256,bool)": {
					"details": "Admin can toggle tiers on and off (e.g., retiring a legacy pricing plan)."
				},
				"transferLicense(uint256,address)": {
					"details": "3. User transfers their remaining time to another wallet. Prevents sharing passwords; one license = one wallet."
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				},
				"withdrawRevenue()": {
					"details": "5. Admin withdraws SaaS revenue securely."
				}
			},
