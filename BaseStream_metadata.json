		"devdoc": {
			"details": "Enterprise continuous payroll and payment streaming. Funds are locked and unlocked mathematically second-by-second. Solves freelance trust issues and traditional payday friction.",
			"kind": "dev",
			"methods": {
				"balanceEarned(uint256)": {
					"details": "Calculates the exact amount earned by the recipient up to this exact block timestamp."
				},
				"cancelStream(uint256)": {
					"details": "3. Either party can cancel. The employee instantly gets what they earned up to this second. The employer gets the rest. No HR math required."
				},
				"createStream(address,uint256)": {
					"details": "1. Employer creates a payment stream.",
					"params": {
						"_durationInSeconds": "Total duration of the contract/pay period.",
						"_recipient": "The employee receiving the funds."
					}
				},
				"withdraw(uint256,uint256)": {
					"details": "2. Employee withdraws their unlocked pay. Can be called at any time."
				}
