		"devdoc": {
			"details": "Enterprise-grade Voluntary Carbon Market (VCM) Protocol. Eliminates brokers and \"Double Counting\" fraud. Allows eco-projects to sell verified carbon credits directly to corporations. Corporations \"Retire\" credits to generate immutable public proof of offset.",
			"errors": {
				"OwnableInvalidOwner(address)": [
					{
						"details": "The owner is not a valid owner account. (eg. `address(0)`)"
					}
				],
				"OwnableUnauthorizedAccount(address)": [
					{
						"details": "The caller account is not authorized to perform an operation."
					}
				],
				"ReentrancyGuardReentrantCall()": [
					{
						"details": "Unauthorized reentrant call."
					}
				]
			},
			"kind": "dev",
			"methods": {
				"buyCredits(uint256,uint256)": {
					"details": "5. Corporation buys carbon credits. Funds bypass brokers and go DIRECTLY to the developer."
				},
				"constructor": {
					"details": "Deployer acts as the Initial Verifier/Auditor (e.g., Verra or Gold Standard)."
				},
				"issueCarbonCredits(uint256,uint256,uint256,uint256)": {
					"details": "3. Auditor mints carbon credits (1 Token = 1 Metric Ton of CO2) after verification."
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"proposeProject(string,string,string)": {
					"details": "1. Eco-Developer proposes a new environmental project."
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"retireCredits(uint256,uint256,string,string)": {
					"details": "6. Corporation permanently RETIRES the credits to offset their carbon footprint. This destroys the fungible credit and generates an immutable Public ESG Certificate."
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				},
				"updateCreditPrice(uint256,uint256)": {
					"details": "4. Developer can adjust the market price of their credits."
				},
				"verifyProject(uint256)": {
					"details": "2. Auditor physically verifies the project in the real world and approves it on-chain."
				}
			},
			"title": "BaseCarbon Registry",
			"version": 1
		},
