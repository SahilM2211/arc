		"devdoc": {
			"details": "Enterprise-grade milestone crowdfunding. Solves the \"Kickstarter Problem\" by forcing creators to get  democratic approval from backers before spending raised funds. Easy Deployment: Empty constructor. You initialize the campaign after deploying.",
			"kind": "dev",
			"methods": {
				"claimRefund()": {
					"details": "3. If campaign fails to meet goal by deadline, backers claim full refunds."
				},
				"contribute()": {
					"details": "2. Backers fund the campaign."
				},
				"createRequest(string,address,uint256)": {
					"details": "4. (If Successful) Creator creates a request to spend funds on a milestone."
				},
				"executeRequest(uint256)": {
					"details": "6. If > 50% of the total raised capital votes YES, the funds are released."
				},
				"getCampaignState()": {
					"details": "Determine the current state of the campaign."
				},
				"initializeCampaign(uint256,uint256)": {
					"details": "1. Initialize the campaign details.",
					"params": {
						"_durationDays": "How long the funding phase lasts.",
						"_goalAmountWei": "The funding goal in WEI."
					}
				},
				"voteOnRequest(uint256,bool)": {
					"details": "5. Backers vote on the spending request. Voting power = ETH contributed."
				}
			},
