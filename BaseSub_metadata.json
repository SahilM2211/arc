		"devdoc": {
			"details": "Enterprise-grade recurring payment and subscription protocol. Solves Web3 recurring billing using a user-funded escrow model. Users deposit ETH once, and authorize creators to claim a fixed amount per time interval. Users can cancel instantly at any time.",
			"kind": "dev",
			"methods": {
				"batchClaimPayments(uint256,address[])": {
					"details": "Enterprise Feature: Batch claim payments for multiple subscribers at once to save gas."
				},
				"claimPayment(uint256,address)": {
					"details": "5. Creator claims the next recurring payment once the time interval has passed. If the user's balance is empty, the subscription is automatically cancelled."
				},
				"createPlan(string,uint256,uint256)": {
					"details": "1. Creator launches a subscription tier (e.g., \"Premium Newsletter\", 0.01 ETH / 30 Days)"
				},
				"deposit()": {
					"details": "2. User tops up their prepaid billing account."
				},
				"subscribe(uint256)": {
					"details": "3. User subscribes to a plan.  Can optionally send ETH in the same transaction to fund their account instantly."
				},
				"unsubscribe(uint256)": {
					"details": "4. User cancels their subscription. No further charges can be made."
				},
				"withdraw(uint256)": {
					"details": "User withdraws unused funds from their billing account."
				}
			},
			"title": "BaseSub Protocol",
			"version": 1
		},
