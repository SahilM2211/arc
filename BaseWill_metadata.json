		"devdoc": {
			"details": "Enterprise-grade Decentralized Estate Planning. Uses a \"Dead Man's Switch\" to automatically pass assets to heirs  if the owner fails to provide \"Proof of Life\" within a specified timeframe. Math: Uses Basis Points (BPS) for exact percentages. 10000 BPS = 100.00%.",
			"kind": "dev",
			"methods": {
				"createVault(address[],uint256[],uint256)": {
					"details": "1. Create your inheritance vault and set your beneficiaries.",
					"params": {
						"_heirs": "Array of wallet addresses to receive funds.",
						"_pingIntervalDays": "How many days you have to ping the contract before it unlocks.",
						"_sharesBPS": "Array of percentages (in Basis Points) for each heir. Must sum to 10000."
					}
				},
				"executeWill(address)": {
					"details": "4. Execute the Will. Anyone can call this IF the timer has expired. Funds are instantly routed to the heirs according to the exact mathematical shares.",
					"params": {
						"_vaultOwner": "The address of the person who created the vault."
					}
				},
				"fundVault()": {
					"details": "2. Fund the vault with ETH. Can be done anytime."
				},
				"ping()": {
					"details": "3. Proof of Life. Resets the countdown timer."
				},
				"revokeVault()": {
					"details": "5. Owner can cancel the will and withdraw all funds at any time while alive."
				}
			},
