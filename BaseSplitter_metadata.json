		"devdoc": {
			"details": "Enterprise-grade Revenue Routing Protocol. All ETH sent to this contract is mathematically divided according to an immutable Cap Table. Solves co-founder disputes and automates accounting/payroll for collectives.",
			"kind": "dev",
			"methods": {
				"constructor": {
					"details": "Creates the immutable Cap Table.",
					"params": {
						"_payees": "Array of wallet addresses.",
						"_shares": "Array of shares (e.g., [50, 25, 25])."
					}
				},
				"pendingPayment(address)": {
					"details": "View function to calculate how much ETH a specific payee is owed right now. Math: (Total ETH ever received * User's Shares / Total Shares) - What user already withdrew."
				},
				"release(address)": {
					"details": "Triggers the release of owed funds to a specific payee. Anyone can call this function (you can pay the gas to route funds to your co-founder)."
				},
				"releaseAll()": {
					"details": "Convenience function to distribute all pending revenue to all payees at once. Highly efficient on L2s like Base."
				}
			},
